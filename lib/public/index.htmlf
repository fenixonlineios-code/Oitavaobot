<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark" data-motion="on">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OTTO — Orientador de Tecnologia e Treinamento do Oitavão</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
/* ========================================================
   OTTO — Design tokens
   ======================================================== */
:root{
  --void:#0b0d12;
  --void-2:#12151c;
  --metal-dark:#383d44;
  --metal-mid:#5b626b;
  --metal-light:#9aa3ad;
  --metal-highlight:#e4e8ec;
  --walnut:#2e2016;
  --walnut-light:#4a3221;
  --copper:#c97a4a;
  --copper-bright:#e89a63;
  --cyan:#6fe0ea;
  --cyan-dim:#3a8f97;
  --amber:#e8b84a;
  --red:#d9544a;
  --green:#7fd88a;
  --glass-fill:rgba(255,255,255,0.05);
  --glass-fill-strong:rgba(255,255,255,0.09);
  --glass-border:rgba(255,255,255,0.14);
  --text-hi:#eef1f4;
  --text-mid:#aab0b9;
  --text-dim:#6b7178;
  --font-display:'Rajdhani',sans-serif;
  --font-body:'Inter',sans-serif;
  --font-mono:'JetBrains Mono',monospace;
  --radius-panel:22px;
  --radius-inset:14px;
  --shadow-deep:0 20px 50px rgba(0,0,0,0.55), 0 2px 0 rgba(255,255,255,0.03) inset;
  --glow-cyan:0 0 18px rgba(111,224,234,.55);
  --glow-copper:0 0 18px rgba(201,122,74,.55);
  --brightness:1;
}

html[data-theme="light"]{
  --void:#dfe2e7;
  --void-2:#eceef1;
  --metal-dark:#c7ccd2;
  --metal-mid:#a9b0b8;
  --metal-light:#7d8590;
  --metal-highlight:#ffffff;
  --walnut:#c9a879;
  --walnut-light:#e0c69c;
  --glass-fill:rgba(255,255,255,0.45);
  --glass-fill-strong:rgba(255,255,255,0.65);
  --glass-border:rgba(20,25,35,0.12);
  --text-hi:#1a1d22;
  --text-mid:#454b53;
  --text-dim:#7a8089;
  --shadow-deep:0 20px 50px rgba(30,35,45,0.18), 0 2px 0 rgba(255,255,255,0.6) inset;
}

*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  background:
    radial-gradient(ellipse at 20% -10%, rgba(111,224,234,0.06), transparent 45%),
    radial-gradient(ellipse at 90% 10%, rgba(201,122,74,0.05), transparent 40%),
    var(--void);
  color:var(--text-hi);
  font-family:var(--font-body);
  -webkit-font-smoothing:antialiased;
  transition:background .4s ease,color .4s ease;
  overflow-x:hidden;
}
::selection{background:var(--cyan);color:#04262a;}

h1,h2,h3,.mono-num{font-family:var(--font-display);letter-spacing:.02em;}
.eyebrow{
  font-family:var(--font-mono);
  font-size:11px;
  letter-spacing:.18em;
  text-transform:uppercase;
  color:var(--cyan-dim);
}
a{color:inherit;}
button{font-family:var(--font-body);}

/* ============ BRUSHED METAL TEXTURE ============ */
.brushed{
  background-image:
    repeating-linear-gradient(100deg, rgba(255,255,255,0.025) 0px, rgba(255,255,255,0.025) 1px, transparent 1px, transparent 3px),
    linear-gradient(160deg, var(--metal-mid), var(--metal-dark) 55%, var(--metal-dark));
}

/* ============ GLASS PANEL ============ */
.glass{
  background:var(--glass-fill);
  backdrop-filter:blur(18px) saturate(140%);
  -webkit-backdrop-filter:blur(18px) saturate(140%);
  border:1px solid var(--glass-border);
  border-radius:var(--radius-panel);
  box-shadow:var(--shadow-deep);
}

/* ============ SCREWS (skeuomorphic detail) ============ */
.screws{position:relative;}
.screws::before,.screws::after,
.screws .screw-tl,.screws .screw-tr,.screws .screw-bl,.screws .screw-br{
  content:'';position:absolute;width:9px;height:9px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%, var(--metal-highlight), var(--metal-mid) 55%, var(--metal-dark) 100%);
  box-shadow:0 1px 2px rgba(0,0,0,.6), inset 0 0 0 1px rgba(0,0,0,.25);
}
.screws::before{top:10px;left:10px;}
.screws::after{top:10px;right:10px;}
.screws .screw-bl{bottom:10px;left:10px;}
.screws .screw-br{bottom:10px;right:10px;}

/* ============ BOOT OVERLAY ============ */
#boot-overlay{
  position:fixed;inset:0;z-index:9999;
  background:radial-gradient(ellipse at 50% 40%, #14181f, #05060a 75%);
  display:flex;align-items:center;justify-content:center;
  transition:opacity .7s ease, visibility .7s ease;
}
#boot-overlay.hidden{opacity:0;visibility:hidden;pointer-events:none;}
.boot-panel{text-align:center;width:min(90vw,420px);}
.boot-logo{
  font-family:var(--font-display);font-weight:700;font-size:56px;letter-spacing:.12em;
  color:var(--cyan);text-shadow:var(--glow-cyan);
}
.boot-sub{color:var(--text-mid);font-size:13px;margin-top:6px;letter-spacing:.03em;}
.boot-bar-track{
  margin-top:28px;height:6px;border-radius:6px;background:rgba(255,255,255,.08);
  overflow:hidden;box-shadow:inset 0 1px 3px rgba(0,0,0,.6);
}
.boot-bar-fill{
  height:100%;width:0%;border-radius:6px;
  background:linear-gradient(90deg,var(--cyan-dim),var(--cyan));
  box-shadow:var(--glow-cyan);
  transition:width .25s ease;
}
.boot-log{margin-top:14px;font-family:var(--font-mono);font-size:11px;color:var(--text-dim);letter-spacing:.04em;}

/* ============ TOPBAR ============ */
.topbar{
  position:sticky;top:0;z-index:500;
  padding:10px 18px;
  background:linear-gradient(180deg, rgba(15,17,22,.86), rgba(15,17,22,.72));
  backdrop-filter:blur(16px);
  border-bottom:1px solid var(--glass-border);
}
html[data-theme="light"] .topbar{background:linear-gradient(180deg, rgba(240,242,245,.86), rgba(240,242,245,.72));}
.topbar-inner{
  max-width:1280px;margin:0 auto;
  display:flex;align-items:center;gap:22px;justify-content:space-between;
}
.brand{display:flex;align-items:center;gap:9px;}
.brand-led{
  width:9px;height:9px;border-radius:50%;background:var(--cyan);
  box-shadow:0 0 8px var(--cyan), 0 0 2px #fff;
  animation:pulse-led 2.6s ease-in-out infinite;
}
@keyframes pulse-led{0%,100%{opacity:1;}50%{opacity:.35;}}
.brand-name{font-family:var(--font-display);font-weight:700;font-size:20px;letter-spacing:.08em;}
.brand-tag{font-family:var(--font-mono);font-size:10px;color:var(--text-dim);border-left:1px solid var(--glass-border);padding-left:9px;letter-spacing:.06em;}
.nav-pills{display:flex;gap:4px;flex:1;justify-content:center;flex-wrap:wrap;}
.pill{
  font-size:12.5px;padding:7px 13px;border-radius:100px;color:var(--text-mid);
  text-decoration:none;letter-spacing:.02em;transition:all .2s ease;white-space:nowrap;
}
.pill:hover{color:var(--text-hi);background:var(--glass-fill);}
.pill.active{color:var(--void);background:var(--cyan);font-weight:600;box-shadow:var(--glow-cyan);}
.topbar-instruments{display:flex;align-items:center;gap:12px;}
.mini-clock{font-family:var(--font-mono);font-size:12px;color:var(--text-mid);letter-spacing:.05em;min-width:64px;text-align:right;}
.power-chip{
  width:30px;height:30px;border-radius:50%;border:none;cursor:pointer;
  background:radial-gradient(circle at 35% 30%, var(--metal-highlight), var(--metal-mid) 60%, var(--metal-dark));
  box-shadow:0 2px 4px rgba(0,0,0,.5), inset 0 0 0 1px rgba(0,0,0,.2);
  display:flex;align-items:center;justify-content:center;
}
.power-chip-dot{width:9px;height:9px;border-radius:50%;background:var(--copper);box-shadow:0 0 6px var(--copper);}
html[data-theme="light"] .power-chip-dot{background:var(--metal-dark);box-shadow:none;}

main{max-width:1280px;margin:0 auto;padding:0 18px;}
section{scroll-margin-top:78px;padding:64px 0;}
.section-head{margin-bottom:30px;max-width:640px;}
.section-head h2{font-size:30px;margin:6px 0 8px;color:var(--text-hi);}
.section-head p{color:var(--text-mid);font-size:14.5px;line-height:1.6;margin:0;}

/* ============ HERO ============ */
.hero{padding:48px 0 20px;display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center;min-height:78vh;}
.hero-copy .eyebrow{margin-bottom:14px;display:inline-block;}
.hero-copy h1{font-size:clamp(34px,4.6vw,54px);line-height:1.06;margin:0 0 18px;color:var(--text-hi);}
.hero-copy h1 em{font-style:normal;color:var(--cyan);text-shadow:0 0 24px rgba(111,224,234,.35);}
.hero-copy p{color:var(--text-mid);font-size:16px;line-height:1.65;max-width:480px;margin:0 0 26px;}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;}
.btn{
  font-family:var(--font-body);font-weight:600;font-size:14px;padding:13px 22px;border-radius:14px;
  cursor:pointer;border:none;letter-spacing:.01em;transition:transform .15s ease, box-shadow .15s ease;
}
.btn:active{transform:translateY(1px) scale(.99);}
.btn-primary{
  background:linear-gradient(160deg,var(--copper-bright),var(--copper));
  color:#20110a;box-shadow:0 8px 20px rgba(201,122,74,.35), inset 0 1px 0 rgba(255,255,255,.4);
}
.btn-primary:hover{box-shadow:0 10px 26px rgba(201,122,74,.5), inset 0 1px 0 rgba(255,255,255,.4);}
.btn-ghost{
  background:var(--glass-fill);color:var(--text-hi);border:1px solid var(--glass-border);
}
.btn-ghost:hover{background:var(--glass-fill-strong);}

.hero-stats{display:flex;gap:26px;margin-top:34px;}
.hero-stat b{display:block;font-family:var(--font-display);font-size:24px;color:var(--cyan);}
.hero-stat span{font-size:11.5px;color:var(--text-dim);letter-spacing:.03em;}

/* ============ OTTO CORE VIEWPORT (skeuomorphic dome + glass) ============ */
.core-rig{position:relative;display:flex;align-items:center;justify-content:center;}
.core-bezel{
  position:relative;width:min(92%,460px);aspect-ratio:1/1;border-radius:50%;
  background:conic-gradient(from 180deg, var(--metal-dark), var(--metal-light) 15%, var(--metal-dark) 30%, var(--metal-mid) 48%, var(--metal-highlight) 52%, var(--metal-dark) 65%, var(--metal-light) 82%, var(--metal-dark));
  box-shadow:0 30px 60px rgba(0,0,0,.55), inset 0 0 0 3px rgba(0,0,0,.4), inset 0 2px 10px rgba(255,255,255,.15);
  padding:16px;
}
.core-bezel-inner{
  width:100%;height:100%;border-radius:50%;position:relative;overflow:hidden;
  background:radial-gradient(ellipse at 50% 40%, #10151d, #040507 78%);
  box-shadow:inset 0 0 40px rgba(0,0,0,.85), inset 0 0 0 2px rgba(255,255,255,.06);
}
#otto-canvas{width:100%;height:100%;display:block;}
.core-glass-sheen{
  position:absolute;inset:0;border-radius:50%;pointer-events:none;
  background:linear-gradient(125deg, rgba(255,255,255,.16) 0%, rgba(255,255,255,0) 30%, rgba(255,255,255,0) 70%, rgba(255,255,255,.05) 100%);
}
.core-ring-mark{position:absolute;inset:-2px;border-radius:50%;border:1px dashed rgba(255,255,255,.08);pointer-events:none;}
.core-tick{position:absolute;inset:0;}
.core-readout{
  position:absolute;bottom:22px;left:50%;transform:translateX(-50%);
  font-family:var(--font-mono);font-size:11px;color:var(--cyan);letter-spacing:.08em;
  background:rgba(0,0,0,.35);padding:5px 12px;border-radius:100px;border:1px solid rgba(111,224,234,.25);
  backdrop-filter:blur(6px);
}
.core-readout .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--cyan);margin-right:6px;box-shadow:0 0 6px var(--cyan);}

/* ============ GAUGES (skeuomorphic dials) ============ */
.gauge-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;}
.gauge-panel{padding:24px 20px 20px;text-align:center;position:relative;}
.gauge-panel .eyebrow{display:block;margin-bottom:10px;}
.gauge{
  width:150px;height:150px;margin:0 auto;position:relative;border-radius:50%;
  background:radial-gradient(circle at 35% 30%, #22262e, #0c0e12 72%);
  box-shadow:inset 0 0 0 6px var(--metal-dark), inset 0 0 0 8px rgba(0,0,0,.4), inset 0 4px 14px rgba(0,0,0,.7), 0 6px 16px rgba(0,0,0,.35);
}
.gauge-face{position:absolute;inset:0;}
.gauge-tick{
  position:absolute;left:50%;top:50%;width:2px;height:70px;transform-origin:50% 100%;
  background:linear-gradient(180deg, var(--metal-light) 0, var(--metal-light) 11px, transparent 11px, transparent 100%);
}
.gauge-tick.major{
  width:2.5px;
  background:linear-gradient(180deg, var(--text-hi) 0, var(--text-hi) 14px, transparent 14px, transparent 100%);
}
.gauge-needle{
  position:absolute;left:50%;top:50%;width:3px;height:56px;
  background:linear-gradient(180deg,var(--copper-bright),var(--copper));
  transform-origin:50% 100%;border-radius:3px 3px 0 0;
  box-shadow:0 0 8px rgba(201,122,74,.6);
  transition:transform .6s cubic-bezier(.34,1.4,.64,1);
}
.gauge-hub{
  position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%, var(--metal-highlight), var(--metal-mid) 60%, var(--metal-dark));
  box-shadow:0 1px 3px rgba(0,0,0,.6);
}
.gauge-value{margin-top:12px;font-family:var(--font-mono);font-size:20px;color:var(--text-hi);}
.gauge-label{font-size:12px;color:var(--text-mid);margin-top:2px;}

/* ============ ASSISTANT / CHAT ============ */
.assist-wrap{display:grid;grid-template-columns:1.3fr .9fr;gap:20px;}
@media (max-width:860px){.assist-wrap{grid-template-columns:1fr;}}
.chat-panel{padding:0;display:flex;flex-direction:column;height:520px;overflow:hidden;}
.chat-head{
  display:flex;align-items:center;gap:10px;padding:16px 20px;border-bottom:1px solid var(--glass-border);
}
.chat-avatar{
  width:34px;height:34px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#0f2a2d,#010203 75%);
  box-shadow:0 0 0 2px var(--metal-dark), 0 0 10px rgba(111,224,234,.4);
  position:relative;
}
.chat-avatar::after{
  content:'';position:absolute;inset:8px;border-radius:50%;background:var(--cyan);opacity:.7;filter:blur(3px);
  animation:pulse-led 2.4s ease-in-out infinite;
}
.chat-head b{font-size:14px;}
.chat-head span{display:block;font-size:11px;color:var(--green);font-family:var(--font-mono);}
.chat-body{flex:1;overflow-y:auto;padding:18px 20px;display:flex;flex-direction:column;gap:12px;}
.msg{max-width:82%;padding:11px 15px;border-radius:16px;font-size:13.5px;line-height:1.55;}
.msg.otto{align-self:flex-start;background:var(--glass-fill-strong);border:1px solid var(--glass-border);border-bottom-left-radius:4px;}
.msg.user{align-self:flex-end;background:linear-gradient(160deg,var(--copper-bright),var(--copper));color:#20110a;border-bottom-right-radius:4px;font-weight:500;}
.msg.typing{display:flex;gap:4px;align-items:center;padding:13px 16px;}
.msg.typing span{width:6px;height:6px;border-radius:50%;background:var(--text-mid);animation:typing-bounce 1s infinite ease-in-out;}
.msg.typing span:nth-child(2){animation-delay:.15s;}
.msg.typing span:nth-child(3){animation-delay:.3s;}
@keyframes typing-bounce{0%,60%,100%{transform:translateY(0);opacity:.4;}30%{transform:translateY(-4px);opacity:1;}}
.chat-suggest{display:flex;gap:8px;flex-wrap:wrap;padding:0 20px 14px;}
.chip{
  font-size:11.5px;padding:6px 12px;border-radius:100px;border:1px solid var(--glass-border);
  background:var(--glass-fill);cursor:pointer;color:var(--text-mid);transition:all .15s ease;
}
.chip:hover{color:var(--text-hi);border-color:var(--cyan-dim);}
.chat-input-row{display:flex;gap:10px;padding:14px 16px;border-top:1px solid var(--glass-border);background:var(--glass-fill);}
.chat-input-row input{
  flex:1;background:rgba(0,0,0,.25);border:1px solid var(--glass-border);border-radius:12px;
  padding:12px 14px;color:var(--text-hi);font-family:var(--font-body);font-size:13.5px;outline:none;
}
html[data-theme="light"] .chat-input-row input{background:rgba(255,255,255,.5);}
.chat-input-row input:focus{border-color:var(--cyan-dim);box-shadow:0 0 0 3px rgba(111,224,234,.15);}
.send-btn{
  width:42px;height:42px;border-radius:12px;border:none;cursor:pointer;flex-shrink:0;
  background:radial-gradient(circle at 35% 30%,var(--copper-bright),var(--copper));
  box-shadow:0 3px 8px rgba(201,122,74,.4), inset 0 1px 0 rgba(255,255,255,.4);
  display:flex;align-items:center;justify-content:center;
}
.send-btn:active{transform:scale(.94);}

.side-stack{display:flex;flex-direction:column;gap:16px;}
.mini-panel{padding:18px 20px;}
.mini-panel h3{font-size:14px;margin:0 0 12px;color:var(--text-hi);}
.tool-row{display:flex;flex-direction:column;gap:10px;}
.tool-row label{font-size:11.5px;color:var(--text-dim);font-family:var(--font-mono);}
.select-skeu, .input-skeu{
  width:100%;background:rgba(0,0,0,.25);border:1px solid var(--glass-border);border-radius:10px;
  padding:10px 12px;color:var(--text-hi);font-family:var(--font-body);font-size:13px;outline:none;
}
html[data-theme="light"] .select-skeu, html[data-theme="light"] .input-skeu{background:rgba(255,255,255,.5);}
.result-box{
  margin-top:6px;padding:14px;border-radius:12px;background:rgba(111,224,234,.08);
  border:1px solid rgba(111,224,234,.25);font-family:var(--font-mono);font-size:12.5px;color:var(--cyan);
  line-height:1.6;
}

/* ============ COURSES ============ */
.course-toolbar{display:flex;gap:10px;margin-bottom:22px;flex-wrap:wrap;}
.search-box{position:relative;flex:1;min-width:220px;}
.search-box input{
  width:100%;padding:12px 14px 12px 40px;border-radius:12px;background:var(--glass-fill);
  border:1px solid var(--glass-border);color:var(--text-hi);font-size:13.5px;outline:none;
}
.search-box input:focus{border-color:var(--cyan-dim);}
.search-box svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);opacity:.5;}
.filter-tabs{display:flex;gap:6px;flex-wrap:wrap;}
.filter-tab{
  padding:10px 15px;border-radius:12px;background:var(--glass-fill);border:1px solid var(--glass-border);
  font-size:12.5px;color:var(--text-mid);cursor:pointer;white-space:nowrap;
}
.filter-tab.active{background:var(--cyan);color:var(--void);border-color:var(--cyan);font-weight:600;}
.course-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;}
.course-card{padding:20px;display:flex;gap:16px;align-items:center;}
.knob{
  width:64px;height:64px;border-radius:50%;flex-shrink:0;position:relative;
  background:conic-gradient(var(--cyan) calc(var(--pct,0)*1%), rgba(255,255,255,.08) 0);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 4px 10px rgba(0,0,0,.35);
}
.knob::before{
  content:'';position:absolute;inset:7px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%, var(--metal-highlight), var(--metal-mid) 60%, var(--metal-dark));
  box-shadow:inset 0 1px 3px rgba(0,0,0,.5);
}
.knob span{position:relative;z-index:2;font-family:var(--font-mono);font-size:12px;font-weight:700;color:var(--void);}
html[data-theme="dark"] .knob span{color:var(--text-hi);}
.course-info{flex:1;min-width:0;}
.course-info b{display:block;font-size:14.5px;margin-bottom:3px;}
.course-info .cat{font-size:10.5px;color:var(--cyan-dim);font-family:var(--font-mono);letter-spacing:.04em;text-transform:uppercase;}
.course-info p{font-size:12px;color:var(--text-mid);margin:6px 0 10px;line-height:1.5;}
.course-btn{
  font-size:11.5px;padding:7px 13px;border-radius:9px;border:1px solid var(--glass-border);
  background:var(--glass-fill);cursor:pointer;color:var(--text-hi);
}
.course-btn.done{background:rgba(127,216,138,.15);border-color:rgba(127,216,138,.4);color:var(--green);cursor:default;}

/* ============ FAQ / KNOWLEDGE BASE ============ */
.faq-list{display:flex;flex-direction:column;gap:10px;}
.faq-item{padding:0;overflow:hidden;}
.faq-q{
  width:100%;text-align:left;padding:17px 20px;background:none;border:none;cursor:pointer;
  display:flex;justify-content:space-between;align-items:center;color:var(--text-hi);font-size:14px;font-weight:500;
}
.faq-q .arrow{transition:transform .25s ease;color:var(--text-dim);flex-shrink:0;margin-left:12px;}
.faq-item.open .faq-q .arrow{transform:rotate(135deg);}
.faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;}
.faq-item.open .faq-a{max-height:220px;}
.faq-a p{margin:0;padding:0 20px 18px;color:var(--text-mid);font-size:13.5px;line-height:1.65;}
.faq-empty{padding:30px;text-align:center;color:var(--text-dim);font-size:13.5px;}

/* ============ TICKETS ============ */
.ticket-wrap{display:grid;grid-template-columns:.85fr 1.15fr;gap:20px;}
@media (max-width:860px){.ticket-wrap{grid-template-columns:1fr;}}
.ticket-form{padding:22px;}
.field{margin-bottom:14px;}
.field label{display:block;font-size:11.5px;color:var(--text-dim);font-family:var(--font-mono);margin-bottom:6px;}
.priority-row{display:flex;gap:8px;}
.priority-opt{
  flex:1;text-align:center;padding:9px 6px;border-radius:10px;border:1px solid var(--glass-border);
  background:var(--glass-fill);font-size:12px;cursor:pointer;color:var(--text-mid);
}
.priority-opt[data-p="Baixa"].sel{background:rgba(127,216,138,.18);border-color:var(--green);color:var(--green);}
.priority-opt[data-p="Média"].sel{background:rgba(232,184,74,.18);border-color:var(--amber);color:var(--amber);}
.priority-opt[data-p="Alta"].sel{background:rgba(217,84,74,.18);border-color:var(--red);color:var(--red);}
.ticket-list{display:flex;flex-direction:column;gap:10px;max-height:460px;overflow-y:auto;padding-right:2px;}
.ticket-card{padding:15px 16px;display:flex;align-items:flex-start;gap:12px;}
.ticket-led{width:9px;height:9px;border-radius:50%;margin-top:5px;flex-shrink:0;}
.ticket-led.p-Baixa{background:var(--green);box-shadow:0 0 6px var(--green);}
.ticket-led.p-Média{background:var(--amber);box-shadow:0 0 6px var(--amber);}
.ticket-led.p-Alta{background:var(--red);box-shadow:0 0 6px var(--red);}
.ticket-body{flex:1;min-width:0;}
.ticket-body b{font-size:13.5px;display:block;}
.ticket-meta{font-size:11px;color:var(--text-dim);font-family:var(--font-mono);margin-top:3px;}
.ticket-actions{display:flex;gap:6px;flex-shrink:0;}
.icon-btn{
  width:28px;height:28px;border-radius:8px;border:1px solid var(--glass-border);background:var(--glass-fill);
  display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text-mid);
}
.icon-btn:hover{color:var(--text-hi);}
.ticket-card.resolved{opacity:.5;}
.ticket-card.resolved .ticket-body b{text-decoration:line-through;}
.ticket-empty{padding:40px 20px;text-align:center;color:var(--text-dim);font-size:13px;}

/* ============ CONTROL PANEL ============ */
.control-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;}
.control-card{padding:20px;display:flex;flex-direction:column;gap:14px;}
.control-card h3{font-size:13.5px;margin:0;display:flex;justify-content:space-between;align-items:center;}
.control-card p{font-size:11.5px;color:var(--text-dim);margin:0;line-height:1.5;}
.rocker{
  width:56px;height:30px;border-radius:100px;position:relative;cursor:pointer;flex-shrink:0;
  background:linear-gradient(180deg, var(--metal-dark), var(--metal-mid));
  box-shadow:inset 0 2px 5px rgba(0,0,0,.6), inset 0 -1px 0 rgba(255,255,255,.08);
  padding:3px;
}
.rocker .knob-ball{
  width:24px;height:24px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%, var(--metal-highlight), var(--metal-light) 60%, var(--metal-mid));
  box-shadow:0 2px 4px rgba(0,0,0,.5);
  transition:transform .25s cubic-bezier(.5,1.6,.5,1);
}
.rocker.on{background:linear-gradient(180deg,var(--cyan-dim),var(--cyan));}
.rocker.on .knob-ball{transform:translateX(26px);background:radial-gradient(circle at 35% 30%,#fff,var(--metal-highlight));}
.slider-skeu{
  -webkit-appearance:none;appearance:none;width:100%;height:8px;border-radius:8px;
  background:linear-gradient(90deg, var(--copper) calc(var(--val,50)*1%), rgba(255,255,255,.1) 0);
  box-shadow:inset 0 1px 3px rgba(0,0,0,.5);outline:none;
}
.slider-skeu::-webkit-slider-thumb{
  -webkit-appearance:none;width:20px;height:20px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%, var(--metal-highlight), var(--metal-mid) 60%, var(--metal-dark));
  box-shadow:0 2px 5px rgba(0,0,0,.5);cursor:pointer;border:2px solid var(--copper);
}
.slider-skeu::-moz-range-thumb{
  width:20px;height:20px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%, var(--metal-highlight), var(--metal-mid) 60%, var(--metal-dark));
  box-shadow:0 2px 5px rgba(0,0,0,.5);cursor:pointer;border:2px solid var(--copper);
}
.row-between{display:flex;justify-content:space-between;align-items:center;}
.clock-widget{display:flex;align-items:center;gap:16px;}
.analog-clock{
  width:74px;height:74px;border-radius:50%;flex-shrink:0;position:relative;
  background:radial-gradient(circle at 35% 30%,#20242c,#0a0c10 75%);
  box-shadow:inset 0 0 0 4px var(--metal-dark), inset 0 3px 8px rgba(0,0,0,.7);
}
.clock-hand{position:absolute;left:50%;top:50%;background:var(--text-hi);border-radius:2px;transform-origin:50% 100%;}
.hand-h{width:2.5px;height:18px;margin-left:-1.25px;margin-top:-18px;}
.hand-m{width:2px;height:25px;margin-left:-1px;margin-top:-25px;}
.hand-s{width:1px;height:27px;margin-left:-.5px;margin-top:-27px;background:var(--copper);}
.digital-time{font-family:var(--font-mono);font-size:18px;color:var(--text-hi);}
.digital-date{font-family:var(--font-mono);font-size:11px;color:var(--text-dim);margin-top:2px;}

/* ============ CONTACT / TICKET FORM SUBMIT ============ */
.toast{
  position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(20px);
  padding:14px 22px;border-radius:14px;background:var(--glass-fill-strong);border:1px solid var(--glass-border);
  backdrop-filter:blur(16px);box-shadow:var(--shadow-deep);font-size:13px;display:flex;align-items:center;gap:10px;
  opacity:0;pointer-events:none;transition:all .35s cubic-bezier(.3,1,.4,1);z-index:600;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto;}
.toast .dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);}

/* ============ FIXED OTTO LED (status) ============ */
.otto-led-fixed{
  position:fixed;right:18px;bottom:18px;z-index:400;
  display:flex;align-items:center;gap:8px;padding:9px 14px;border-radius:100px;
  background:var(--glass-fill-strong);border:1px solid var(--glass-border);backdrop-filter:blur(14px);
  box-shadow:var(--shadow-deep);font-family:var(--font-mono);font-size:11px;color:var(--text-mid);
}
.led-fixed-dot{width:8px;height:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 8px var(--cyan);animation:pulse-led 2.4s ease-in-out infinite;}
.led-fixed-dot.thinking{background:var(--amber);box-shadow:0 0 8px var(--amber);}
.led-fixed-dot.alert{background:var(--red);box-shadow:0 0 8px var(--red);}

/* ============ FOOTER ============ */
footer{border-top:1px solid var(--glass-border);margin-top:40px;padding:36px 18px 90px;}
.footer-inner{max-width:1280px;margin:0 auto;display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;}
.footer-inner .brand-name{font-family:var(--font-display);font-weight:700;}
footer p{color:var(--text-dim);font-size:12px;line-height:1.7;max-width:420px;}
footer a{color:var(--cyan-dim);text-decoration:none;}
.ticker{
  font-family:var(--font-mono);font-size:11px;color:var(--text-dim);margin-top:14px;
  display:flex;gap:8px;flex-wrap:wrap;
}
.ticker span{padding:4px 10px;border-radius:100px;background:var(--glass-fill);border:1px solid var(--glass-border);}

/* ============ REDUCED MOTION ============ */
html[data-motion="off"] *{animation-duration:0.001s !important;animation-iteration-count:1 !important;transition-duration:0.001s !important;}

@media (max-width:900px){
  .hero{grid-template-columns:1fr;padding-top:24px;min-height:auto;}
  .nav-pills{display:none;}
}

</style>
</head>
<body>

<!-- ============ BOOT OVERLAY ============ -->
<div id="boot-overlay">
  <div class="boot-panel">
    <div class="boot-logo">OTTO</div>
    <div class="boot-sub">Orientador de Tecnologia e Treinamento do Oitavão</div>
    <div class="boot-bar-track"><div class="boot-bar-fill" id="boot-fill"></div></div>
    <div class="boot-log" id="boot-log">inicializando núcleo…</div>
  </div>
</div>

<!-- ============ TOPBAR ============ -->
<header class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <span class="brand-led" id="brand-led"></span>
      <span class="brand-name">OTTO</span>
      <span class="brand-tag">Oitavão</span>
    </div>
    <nav class="nav-pills" id="nav-pills">
      <a href="#painel" class="pill active">Painel</a>
      <a href="#assistente" class="pill">Assistente</a>
      <a href="#treinamentos" class="pill">Treinamentos</a>
      <a href="#base" class="pill">Base de Conhecimento</a>
      <a href="#chamados" class="pill">Chamados</a>
      <a href="#controle" class="pill">Controle</a>
    </nav>
    <div class="topbar-instruments">
      <div class="mini-clock" id="mini-clock">--:--:--</div>
      <button class="power-chip" id="theme-toggle-chip" title="Alternar tema" aria-label="Alternar tema">
        <span class="power-chip-dot"></span>
      </button>
    </div>
  </div>
</header>

<main>
<section class="hero" id="painel">
  <div class="hero-copy">
    <span class="eyebrow">SISTEMA ATIVO · OITAVÃO</span>
    <h1>Seu time de tecnologia<br>agora tem um <em>núcleo</em>.</h1>
    <p>OTTO reúne suporte técnico, treinamentos e base de conhecimento do Oitavão em um único painel. Pergunte, aprenda e resolva — tudo em tempo real, sem sair da tela.</p>
    <div class="hero-actions">
      <button class="btn btn-primary" data-scroll="#assistente">Falar com o OTTO</button>
      <button class="btn btn-ghost" data-scroll="#treinamentos">Ver treinamentos</button>
    </div>
    <div class="hero-stats">
      <div class="hero-stat"><b id="stat-uptime">99.9%</b><span>DISPONIBILIDADE</span></div>
      <div class="hero-stat"><b id="stat-courses">12</b><span>TRILHAS ATIVAS</span></div>
      <div class="hero-stat"><b id="stat-tickets">0</b><span>CHAMADOS ABERTOS</span></div>
    </div>
  </div>

  <div class="core-rig">
    <div class="core-bezel screws">
      <span class="screw-tl"></span><span class="screw-tr"></span><span class="screw-bl"></span><span class="screw-br"></span>
      <div class="core-bezel-inner">
        <canvas id="otto-canvas"></canvas>
        <div class="core-glass-sheen"></div>
      </div>
      <div class="core-ring-mark"></div>
      <div class="core-readout"><span class="dot"></span><span id="core-readout-text">NÚCLEO ESTÁVEL</span></div>
    </div>
  </div>
</section>

<section id="diagnostico">
  <div class="section-head">
    <span class="eyebrow">TELEMETRIA</span>
    <h2>Painel de diagnóstico</h2>
    <p>Leitura contínua da saúde dos sistemas do Oitavão. Os ponteiros respondem à carga simulada em tempo real.</p>
  </div>
  <div class="gauge-grid">
    <div class="gauge-panel glass screws">
      <span class="screw-tl"></span><span class="screw-tr"></span><span class="screw-bl"></span><span class="screw-br"></span>
      <span class="eyebrow">PROCESSAMENTO</span>
      <div class="gauge" id="gauge-cpu">
        <div class="gauge-face" id="gauge-cpu-ticks"></div>
        <div class="gauge-needle" id="gauge-cpu-needle"></div>
        <div class="gauge-hub"></div>
      </div>
      <div class="gauge-value" id="gauge-cpu-value">—</div>
      <div class="gauge-label">CPU · núcleo OTTO</div>
    </div>
    <div class="gauge-panel glass screws">
      <span class="screw-tl"></span><span class="screw-tr"></span><span class="screw-bl"></span><span class="screw-br"></span>
      <span class="eyebrow">CONECTIVIDADE</span>
      <div class="gauge" id="gauge-net">
        <div class="gauge-face" id="gauge-net-ticks"></div>
        <div class="gauge-needle" id="gauge-net-needle"></div>
        <div class="gauge-hub"></div>
      </div>
      <div class="gauge-value" id="gauge-net-value">—</div>
      <div class="gauge-label">Rede · latência</div>
    </div>
    <div class="gauge-panel glass screws">
      <span class="screw-tl"></span><span class="screw-tr"></span><span class="screw-bl"></span><span class="screw-br"></span>
      <span class="eyebrow">ARMAZENAMENTO</span>
      <div class="gauge" id="gauge-disk">
        <div class="gauge-face" id="gauge-disk-ticks"></div>
        <div class="gauge-needle" id="gauge-disk-needle"></div>
        <div class="gauge-hub"></div>
      </div>
      <div class="gauge-value" id="gauge-disk-value">—</div>
      <div class="gauge-label">Disco · backups</div>
    </div>
  </div>
</section>

<section id="assistente">
  <div class="section-head">
    <span class="eyebrow">IA DE SUPORTE</span>
    <h2>Assistente OTTO</h2>
    <p>Descreva o problema ou dúvida. O OTTO responde com base nos procedimentos internos do Oitavão.</p>
  </div>
  <div class="assist-wrap">
    <div class="chat-panel glass">
      <div class="chat-head">
        <div class="chat-avatar"></div>
        <div>
          <b>OTTO</b>
          <span id="chat-status-text">● on-line</span>
        </div>
      </div>
      <div class="chat-body" id="chat-body"></div>
      <div class="chat-suggest" id="chat-suggest">
        <button class="chip" data-q="Como resetar minha senha?">Resetar senha</button>
        <button class="chip" data-q="O wifi do Oitavão caiu, o que eu faço?">Wifi caiu</button>
        <button class="chip" data-q="Quais treinamentos estão disponíveis?">Treinamentos disponíveis</button>
        <button class="chip" data-q="Como abro um chamado?">Abrir chamado</button>
      </div>
      <form class="chat-input-row" id="chat-form">
        <input type="text" id="chat-input" placeholder="Digite sua pergunta para o OTTO…" autocomplete="off">
        <button type="submit" class="send-btn" aria-label="Enviar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 11.5L21 3l-8.5 18-2.5-8-7-1.5z" stroke="#20110a" stroke-width="1.8" stroke-linejoin="round"/></svg>
        </button>
      </form>
    </div>

    <div class="side-stack">
      <div class="mini-panel glass">
        <h3>Estimador de resolução</h3>
        <div class="tool-row">
          <label>TIPO DE PROBLEMA</label>
          <select class="select-skeu" id="est-type">
            <option value="acesso">Acesso e senha</option>
            <option value="rede">Rede e wifi</option>
            <option value="hardware">Hardware / equipamento</option>
            <option value="software">Instalação de software</option>
            <option value="treinamento">Dúvida de treinamento</option>
          </select>
          <label>URGÊNCIA</label>
          <select class="select-skeu" id="est-urgency">
            <option value="baixa">Baixa</option>
            <option value="media" selected>Média</option>
            <option value="alta">Alta</option>
          </select>
          <button class="btn btn-ghost" id="est-btn" type="button" style="margin-top:4px;">Estimar tempo</button>
          <div class="result-box" id="est-result">Selecione as opções e clique em estimar.</div>
        </div>
      </div>

      <div class="mini-panel glass">
        <h3>Relógio da central</h3>
        <div class="clock-widget">
          <div class="analog-clock" id="analog-clock">
            <div class="clock-hand hand-h" id="hand-h"></div>
            <div class="clock-hand hand-m" id="hand-m"></div>
            <div class="clock-hand hand-s" id="hand-s"></div>
          </div>
          <div>
            <div class="digital-time" id="digital-time">--:--:--</div>
            <div class="digital-date" id="digital-date">-- -- ----</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="treinamentos">
  <div class="section-head">
    <span class="eyebrow">CAPACITAÇÃO</span>
    <h2>Central de treinamentos</h2>
    <p>Trilhas técnicas do Oitavão. Continue de onde parou — o progresso fica salvo nesta sessão.</p>
  </div>
  <div class="course-toolbar">
    <div class="search-box">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <input type="text" id="course-search" placeholder="Buscar trilha…">
    </div>
    <div class="filter-tabs" id="course-filters">
      <button class="filter-tab active" data-cat="todos">Todos</button>
      <button class="filter-tab" data-cat="infra">Infraestrutura</button>
      <button class="filter-tab" data-cat="seguranca">Segurança</button>
      <button class="filter-tab" data-cat="dev">Desenvolvimento</button>
      <button class="filter-tab" data-cat="dados">Dados</button>
    </div>
  </div>
  <div class="course-grid" id="course-grid"></div>
</section>

<section id="base">
  <div class="section-head">
    <span class="eyebrow">DOCUMENTAÇÃO VIVA</span>
    <h2>Base de conhecimento</h2>
    <p>Respostas rápidas para as dúvidas mais comuns no Oitavão. Digite para filtrar.</p>
  </div>
  <div class="search-box" style="max-width:420px;margin-bottom:22px;">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <input type="text" id="faq-search" placeholder="Buscar na base de conhecimento…">
  </div>
  <div class="faq-list glass" id="faq-list" style="padding:6px;"></div>
</section>

<section id="chamados">
  <div class="section-head">
    <span class="eyebrow">SUPORTE DIRETO</span>
    <h2>Central de chamados</h2>
    <p>Abra um chamado para a equipe técnica do Oitavão. Acompanhe o status por aqui.</p>
  </div>
  <div class="ticket-wrap">
    <form class="ticket-form glass" id="ticket-form">
      <div class="field">
        <label>ASSUNTO</label>
        <input type="text" class="input-skeu" id="ticket-title" placeholder="Ex.: Impressora do 2º andar sem toner" required>
      </div>
      <div class="field">
        <label>DESCRIÇÃO (OPCIONAL)</label>
        <input type="text" class="input-skeu" id="ticket-desc" placeholder="Detalhes adicionais">
      </div>
      <div class="field">
        <label>PRIORIDADE</label>
        <div class="priority-row" id="priority-row">
          <div class="priority-opt sel" data-p="Baixa">Baixa</div>
          <div class="priority-opt" data-p="Média">Média</div>
          <div class="priority-opt" data-p="Alta">Alta</div>
        </div>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;">Abrir chamado</button>
    </form>
    <div class="ticket-list glass" id="ticket-list" style="padding:14px;"></div>
  </div>
</section>

<section id="controle">
  <div class="section-head">
    <span class="eyebrow">PREFERÊNCIAS</span>
    <h2>Painel de controle</h2>
    <p>Ajustes do console — tudo aplicado na hora, sem recarregar a página.</p>
  </div>
  <div class="control-grid">
    <div class="control-card glass">
      <h3>Tema do console <span class="rocker" id="rocker-theme"><span class="knob-ball"></span></span></h3>
      <p>Alterna entre o modo escuro (cabine) e o modo claro (alumínio).</p>
    </div>
    <div class="control-card glass">
      <h3>Som de interface <span class="rocker on" id="rocker-sound"><span class="knob-ball"></span></span></h3>
      <p>Cliques mecânicos sintetizados ao interagir com botões e chaves.</p>
    </div>
    <div class="control-card glass">
      <h3>Movimento <span class="rocker on" id="rocker-motion"><span class="knob-ball"></span></span></h3>
      <p>Desativa animações e a rotação do núcleo 3D para reduzir estímulos.</p>
    </div>
    <div class="control-card glass">
      <h3 style="display:block;">Brilho do núcleo</h3>
      <input type="range" min="20" max="100" value="70" class="slider-skeu" id="brightness-slider" style="--val:70;">
      <p>Controla a intensidade de luz do buraco negro do OTTO.</p>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="footer-inner">
    <div>
      <div class="brand-name">OTTO</div>
      <p>Orientador de Tecnologia e Treinamento do Oitavão. Console interno de suporte, aprendizagem e diagnóstico — construído para rodar direto no navegador.</p>
      <div class="ticker" id="footer-ticker">
        <span>STATUS: OPERACIONAL</span>
        <span id="ticker-time">--:--:--</span>
        <span>v2.4.1-oitavao</span>
      </div>
    </div>
    <div>
      <p style="max-width:320px;">
        Núcleo visual "Black Hole" por <a href="https://sketchfab.com/3d-models/black-hole-e410da98b1e5445eae2acafaaa53587d" target="_blank" rel="noopener">NestaEric</a>,
        licenciado sob <a href="http://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>, via Sketchfab.
        Geometria reconstruída para renderização leve neste console.
      </p>
    </div>
  </div>
</footer>

<div class="otto-led-fixed" id="otto-led-fixed" title="Status do OTTO">
  <span class="led-fixed-dot" id="led-fixed-dot"></span>
  <span class="led-fixed-text" id="led-fixed-text">OTTO em espera</span>
</div>

<script>
const OTTO_GEO = {"distortion": {"pos_b64": "", "norm_b64": "", "idx_b64": "", "vcount": 4946, "icount": 27960}, "center": {"pos_b64": "", "norm_b64": "", "idx_b64": "", "vcount": 4017, "icount": 23040}, "ring": {"pos_b64": "", "norm_b64": "", "idx_b64": "", "vcount": 3886, "icount": 15792}};

</script>
<script type="module">
/* ================= OTTO — app.js ================= */
let THREE = null;

/* ---------- estado global ---------- */
const state = {
  ottoStatus: 'idle',      // idle | thinking | alert
  sound: true,
  motion: true,
  brightness: 70,
  theme: 'dark',
  tickets: [],
  ticketSeq: 1,
  priority: 'Baixa',
};

/* ---------- util: som sintetizado (sem arquivos externos) ---------- */
let actx = null;
function beep(freq = 520, dur = 0.045, type = 'sine', gain = 0.05) {
  if (!state.sound) return;
  try {
    actx = actx || new (window.AudioContext || window.webkitAudioContext)();
    const osc = actx.createOscillator();
    const g = actx.createGain();
    osc.type = type;
    osc.frequency.value = freq;
    g.gain.value = gain;
    osc.connect(g).connect(actx.destination);
    osc.start();
    g.gain.exponentialRampToValueAtTime(0.0001, actx.currentTime + dur);
    osc.stop(actx.currentTime + dur + 0.02);
  } catch (e) { /* silencioso */ }
}
function clickSound() { beep(600, 0.05, 'square', 0.035); }
function toggleSoundFx(on) { if (on) beep(760, 0.07, 'sine', 0.05); }

/* ================================================================
   1) BOOT SEQUENCE
   ================================================================ */
function runBoot() {
  const overlay = document.getElementById('boot-overlay');
  const fill = document.getElementById('boot-fill');
  const log = document.getElementById('boot-log');
  const msgs = [
    'inicializando núcleo…',
    'carregando telemetria…',
    'sincronizando base de conhecimento…',
    'conectando ao assistente…',
    'sistemas do Oitavão prontos.'
  ];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) {
    overlay.classList.add('hidden');
    document.documentElement.setAttribute('data-motion', 'off');
    document.getElementById('rocker-motion').classList.remove('on');
    state.motion = false;
    return;
  }
  let pct = 0, step = 0;
  const iv = setInterval(() => {
    pct += 8 + Math.random() * 14;
    if (pct >= 100) pct = 100;
    fill.style.width = pct + '%';
    const idx = Math.min(msgs.length - 1, Math.floor((pct / 100) * msgs.length));
    log.textContent = msgs[idx];
    if (pct >= 100) {
      clearInterval(iv);
      setTimeout(() => overlay.classList.add('hidden'), 380);
    }
  }, 140);
}

/* ================================================================
   2) NÚCLEO 3D — OTTO CORE (buraco-negro reconstruído do GLB)
   ================================================================ */
function b64ToFloat32(b64) {
  const bin = atob(b64);
  const buf = new ArrayBuffer(bin.length);
  const view = new Uint8Array(buf);
  for (let i = 0; i < bin.length; i++) view[i] = bin.charCodeAt(i);
  return new Float32Array(buf);
}
function b64ToUint32(b64) {
  const bin = atob(b64);
  const buf = new ArrayBuffer(bin.length);
  const view = new Uint8Array(buf);
  for (let i = 0; i < bin.length; i++) view[i] = bin.charCodeAt(i);
  return new Uint32Array(buf);
}
function buildGeometry(part) {
  const geo = new THREE.BufferGeometry();
  const pos = b64ToFloat32(part.pos_b64);
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  if (part.norm_b64) {
    const norm = b64ToFloat32(part.norm_b64);
    geo.setAttribute('normal', new THREE.BufferAttribute(norm, 3));
  } else {
    geo.computeVertexNormals();
  }
  const idx = b64ToUint32(part.idx_b64);
  geo.setIndex(new THREE.BufferAttribute(idx, 1));
  if (!part.norm_b64) geo.computeVertexNormals();
  geo.computeBoundingSphere();
  return geo;
}

let renderer, scene, camera, coreGroup, ringMesh, centerMesh, distortionMesh, particles;
let targetPulse = 0.55, currentPulse = 0.55;

async function initCore() {
  const canvas = document.getElementById('otto-canvas');

  try {
    THREE = await import('https://cdnjs.cloudflare.com/ajax/libs/three.js/0.161.0/three.module.js');
  } catch (e) {
    coreFallback();
    return;
  }
  try {
    buildCoreScene(canvas);
  } catch (e) {
    coreFallback();
  }
}

function coreFallback() {
  // Núcleo visual alternativo em CSS puro caso o WebGL/CDN não esteja disponível
  const canvas = document.getElementById('otto-canvas');
  const wrap = canvas.parentElement;
  canvas.style.display = 'none';
  const fallback = document.createElement('div');
  fallback.style.cssText = 'position:absolute;inset:0;border-radius:50%;'
    + 'background:radial-gradient(circle at 50% 45%, #0b0d12 0%, #05060a 45%, #05060a 60%, rgba(232,154,99,.35) 62%, rgba(111,224,234,.18) 72%, #05060a 85%);'
    + 'animation:coreSpin 12s linear infinite;';
  const style = document.createElement('style');
  style.textContent = '@keyframes coreSpin{from{filter:hue-rotate(0deg);}to{filter:hue-rotate(20deg);}}';
  document.head.appendChild(style);
  wrap.appendChild(fallback);
}

function buildCoreScene(canvas) {

  renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  scene = new THREE.Scene();
  camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
  camera.position.set(0, 0.15, 5.2);

  coreGroup = new THREE.Group();
  scene.add(coreGroup);

  // centro — horizonte de eventos
  const centerGeo = buildGeometry(OTTO_GEO.center);
  centerMesh = new THREE.Mesh(centerGeo, new THREE.MeshStandardMaterial({
    color: 0x02030a, roughness: 0.35, metalness: 0.1, emissive: 0x000000
  }));
  coreGroup.add(centerMesh);

  // rim / glow sutil por trás do centro (efeito fresnel simplificado)
  const rimMesh = new THREE.Mesh(centerGeo.clone(), new THREE.MeshBasicMaterial({
    color: 0x6fe0ea, transparent: true, opacity: 0.16, side: THREE.BackSide
  }));
  rimMesh.scale.setScalar(1.045);
  coreGroup.add(rimMesh);

  // distorção — halo de lente gravitacional
  const distGeo = buildGeometry(OTTO_GEO.distortion);
  distortionMesh = new THREE.Mesh(distGeo, new THREE.MeshBasicMaterial({
    color: 0x6fe0ea, transparent: true, opacity: 0.10, blending: THREE.AdditiveBlending,
    side: THREE.DoubleSide, depthWrite: false
  }));
  coreGroup.add(distortionMesh);

  // anel — disco de acreção
  const ringGeo = buildGeometry(OTTO_GEO.ring);
  ringMesh = new THREE.Mesh(ringGeo, new THREE.MeshBasicMaterial({
    color: 0xe89a63, transparent: true, opacity: 0.55, blending: THREE.AdditiveBlending,
    side: THREE.DoubleSide, depthWrite: false
  }));
  coreGroup.add(ringMesh);

  // partículas — poeira orbital (proceduralmente geradas, sem textura externa)
  const N = 900;
  const pPos = new Float32Array(N * 3);
  for (let i = 0; i < N; i++) {
    const r = 1.65 + Math.random() * 1.35;
    const a = Math.random() * Math.PI * 2;
    const h = (Math.random() - 0.5) * 0.12;
    pPos[i * 3] = Math.cos(a) * r;
    pPos[i * 3 + 1] = h;
    pPos[i * 3 + 2] = Math.sin(a) * r;
  }
  const pGeo = new THREE.BufferGeometry();
  pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
  particles = new THREE.Points(pGeo, new THREE.PointsMaterial({
    color: 0xf0c98a, size: 0.018, transparent: true, opacity: 0.7,
    blending: THREE.AdditiveBlending, depthWrite: false
  }));
  coreGroup.add(particles);

  // normalizar escala/centralização do grupo
  const box = new THREE.Box3().setFromObject(centerMesh);
  const sphere = box.getBoundingSphere(new THREE.Sphere());
  const scale = 1.35 / (sphere.radius || 1);
  coreGroup.scale.setScalar(scale);
  coreGroup.position.sub(sphere.center.clone().multiplyScalar(scale));

  const amb = new THREE.AmbientLight(0x223344, 1.1);
  scene.add(amb);
  const key = new THREE.PointLight(0xffcf9e, 2.2, 20);
  key.position.set(3, 2, 4);
  scene.add(key);
  const rim = new THREE.PointLight(0x6fe0ea, 1.4, 20);
  rim.position.set(-3, -1, -3);
  scene.add(rim);

  resizeCore();
  window.addEventListener('resize', resizeCore);

  canvas.parentElement.parentElement.addEventListener('pointermove', (e) => {
    const r = canvas.parentElement.getBoundingClientRect();
    const nx = ((e.clientX - r.left) / r.width) * 2 - 1;
    const ny = ((e.clientY - r.top) / r.height) * 2 - 1;
    parallax.x = nx * 0.35;
    parallax.y = ny * 0.2;
  });

  animateCore();
}

const parallax = { x: 0, y: 0 };
let lastFrameTime = performance.now() / 1000;
let elapsedTime = 0;

function resizeCore() {
  const canvas = document.getElementById('otto-canvas');
  const rect = canvas.parentElement.getBoundingClientRect();
  const size = Math.max(rect.width, rect.height);
  renderer.setSize(size, size, false);
  camera.aspect = 1;
  camera.updateProjectionMatrix();
}

function statusColor() {
  if (state.ottoStatus === 'thinking') return new THREE.Color(0xe8b84a);
  if (state.ottoStatus === 'alert') return new THREE.Color(0xd9544a);
  return new THREE.Color(0x6fe0ea);
}

function animateCore() {
  requestAnimationFrame(animateCore);
  const now = performance.now() / 1000;
  const rawDt = Math.min(now - lastFrameTime, 0.1);
  lastFrameTime = now;
  const dt = state.motion ? rawDt : 0;
  elapsedTime += dt;
  const t = elapsedTime;

  if (state.motion) {
    coreGroup.rotation.y += dt * 0.15;
    ringMesh.rotation.z += dt * 0.35;
    particles.rotation.y += dt * 0.09;
    distortionMesh.rotation.y -= dt * 0.06;
  }

  targetPulse = 0.4 + Math.sin(t * (state.ottoStatus === 'thinking' ? 5.5 : 1.1)) * 0.18
    + (state.ottoStatus === 'alert' ? 0.25 : 0);
  currentPulse += (targetPulse - currentPulse) * 0.08;

  const col = statusColor();
  const b = state.brightness / 70;
  ringMesh.material.opacity = (0.4 + currentPulse * 0.5) * b;
  ringMesh.material.color.lerp(col, 0.06);
  distortionMesh.material.color.lerp(col, 0.06);
  distortionMesh.material.opacity = (0.06 + currentPulse * 0.12) * b;

  camera.position.x += (parallax.x - camera.position.x) * 0.04;
  camera.position.y += (0.15 - parallax.y - camera.position.y) * 0.04;
  camera.lookAt(0, 0, 0);

  renderer.render(scene, camera);
}

function setOttoStatus(status) {
  state.ottoStatus = status;
  const dot = document.getElementById('led-fixed-dot');
  const txt = document.getElementById('led-fixed-text');
  const readout = document.getElementById('core-readout-text');
  dot.className = 'led-fixed-dot' + (status !== 'idle' ? ' ' + status : '');
  if (status === 'thinking') { txt.textContent = 'OTTO processando'; readout.textContent = 'ANALISANDO CONSULTA'; }
  else if (status === 'alert') { txt.textContent = 'OTTO em alerta'; readout.textContent = 'ATENÇÃO NECESSÁRIA'; }
  else { txt.textContent = 'OTTO em espera'; readout.textContent = 'NÚCLEO ESTÁVEL'; }
}

/* ================================================================
   3) CHAT — respostas inteligentes por padrão de palavras-chave
   ================================================================ */
const KB_RULES = [
  { k: ['senha', 'password', 'login', 'acesso bloqueado', 'esqueci'],
    a: 'Para redefinir sua senha: acesse <b>portal.oitavao/conta</b>, clique em "Esqueci minha senha" e siga o link enviado ao seu e-mail corporativo. Se o link não chegar em 5 minutos, verifique o spam ou abra um chamado de prioridade alta.' },
  { k: ['wifi', 'wi-fi', 'internet caiu', 'rede caiu', 'sem internet'],
    a: 'Se o wifi caiu: 1) reinicie o roteador local (botão por 10s); 2) verifique o painel de diagnóstico acima — se a rede estiver em vermelho, já é um incidente conhecido; 3) persistindo, abra um chamado de prioridade alta na Central de Chamados.' },
  { k: ['treinamento', 'curso', 'trilha', 'capacitação', 'aprender'],
    a: 'Temos trilhas de Infraestrutura, Segurança, Desenvolvimento e Dados na seção <b>Treinamentos</b>. Use a busca ou os filtros para encontrar a sua e clique em "Continuar" para avançar o progresso.' },
  { k: ['chamado', 'ticket', 'abrir chamado', 'suporte', 'problema técnico'],
    a: 'Você pode abrir um chamado direto na seção <b>Central de Chamados</b>: descreva o assunto, escolha a prioridade e envie. Ele aparece na lista ao lado com status em tempo real.' },
  { k: ['backup', 'cópia de segurança', 'restaurar arquivo'],
    a: 'Os backups do Oitavão rodam automaticamente às 03h. Para restaurar um arquivo específico, abra um chamado de prioridade média informando a pasta e a data aproximada.' },
  { k: ['vpn', 'acesso remoto', 'home office'],
    a: 'A VPN do Oitavão usa autenticação em duas etapas. Instale o cliente indicado no e-mail de boas-vindas e use seu usuário de rede + código do aplicativo autenticador.' },
  { k: ['impressora', 'imprimir', 'toner'],
    a: 'Problemas de impressão costumam ser fila travada. Tente remover o trabalho da fila e reenviar. Se persistir, abra um chamado — recomendo prioridade baixa, a menos que seja urgente.' },
  { k: ['horário', 'expediente', 'atendimento humano', 'falar com alguém'],
    a: 'O suporte humano do Oitavão atende de segunda a sexta, das 8h às 18h. Fora desse horário, eu (OTTO) cuido do primeiro atendimento e encaminho o chamado para a manhã seguinte.' },
  { k: ['obrigado', 'obrigada', 'valeu', 'grato'],
    a: 'Disponha! Se precisar de mais alguma coisa, é só chamar — estou sempre de olho na telemetria. 🛰️' },
  { k: ['oi', 'olá', 'ola', 'bom dia', 'boa tarde', 'boa noite'],
    a: 'Olá! Sou o OTTO, orientador de tecnologia e treinamento do Oitavão. Posso ajudar com acessos, rede, treinamentos ou chamados — o que você precisa?' },
];
const FALLBACKS = [
  'Ainda não tenho uma resposta pronta para isso, mas posso registrar como chamado para a equipe técnica olhar com calma. Quer que eu abra um chamado?',
  'Não encontrei esse procedimento na minha base agora. Tente reformular ou veja a Base de Conhecimento — ou abra um chamado se for algo urgente.',
  'Essa é específica. Recomendo consultar a Base de Conhecimento abaixo ou abrir um chamado para a equipe do Oitavão te responder com detalhes.',
];

function getSmartReply(text) {
  const low = text.toLowerCase();
  for (const rule of KB_RULES) {
    if (rule.k.some(kw => low.includes(kw))) return rule.a;
  }
  return FALLBACKS[Math.floor(Math.random() * FALLBACKS.length)];
}

function addMsg(text, who) {
  const body = document.getElementById('chat-body');
  const div = document.createElement('div');
  div.className = 'msg ' + who;
  div.innerHTML = text;
  body.appendChild(div);
  body.scrollTop = body.scrollHeight;
  return div;
}

function sendChat(text) {
  text = text.trim();
  if (!text) return;
  addMsg(escapeHtml(text), 'user');
  clickSound();
  setOttoStatus('thinking');
  const body = document.getElementById('chat-body');
  const typing = document.createElement('div');
  typing.className = 'msg otto typing';
  typing.innerHTML = '<span></span><span></span><span></span>';
  body.appendChild(typing);
  body.scrollTop = body.scrollHeight;

  const delay = 650 + Math.random() * 700;
  setTimeout(() => {
    typing.remove();
    addMsg(getSmartReply(text), 'otto');
    setOttoStatus('idle');
  }, delay);
}
function escapeHtml(s) {
  return s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function initChat() {
  addMsg('Olá! Sou o OTTO. Posso ajudar com acessos, rede, treinamentos e chamados do Oitavão. Como posso ajudar hoje?', 'otto');
  document.getElementById('chat-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('chat-input');
    sendChat(input.value);
    input.value = '';
  });
  document.getElementById('chat-suggest').addEventListener('click', (e) => {
    const btn = e.target.closest('.chip');
    if (!btn) return;
    sendChat(btn.dataset.q);
  });
}

/* ================================================================
   4) ESTIMADOR DE RESOLUÇÃO
   ================================================================ */
const BASE_TIME = { acesso: 10, rede: 25, hardware: 60, software: 20, treinamento: 5 };
const URGENCY_MULT = { baixa: 1.6, media: 1, alta: 0.55 };
const TYPE_LABEL = { acesso: 'Acesso e senha', rede: 'Rede e wifi', hardware: 'Hardware / equipamento', software: 'Instalação de software', treinamento: 'Dúvida de treinamento' };

function initEstimator() {
  document.getElementById('est-btn').addEventListener('click', () => {
    clickSound();
    const type = document.getElementById('est-type').value;
    const urg = document.getElementById('est-urgency').value;
    const minutes = Math.round(BASE_TIME[type] * URGENCY_MULT[urg]);
    const queue = urg === 'alta' ? 'fila prioritária' : urg === 'media' ? 'fila padrão' : 'fila de baixa prioridade';
    document.getElementById('est-result').innerHTML =
      `Tipo: <b>${TYPE_LABEL[type]}</b><br>Estimativa: <b>${minutes} min</b> após triagem<br>Encaminhamento: ${queue}`;
  });
}

/* ================================================================
   5) GAUGES (telemetria simulada)
   ================================================================ */
function buildTicks(container) {
  for (let i = 0; i <= 10; i++) {
    const tick = document.createElement('div');
    const angle = -120 + i * 24;
    const major = i % 5 === 0;
    tick.className = 'gauge-tick' + (major ? ' major' : '');
    tick.style.transform = `translate(-50%,-100%) rotate(${angle}deg)`;
    container.appendChild(tick);
  }
}
function setGauge(id, value, unit) {
  const needle = document.getElementById(`gauge-${id}-needle`);
  const valueEl = document.getElementById(`gauge-${id}-value`);
  const angle = -120 + (value / 100) * 240;
  needle.style.transform = `translate(-50%,-100%) rotate(${angle}deg)`;
  valueEl.textContent = unit === '%' ? `${Math.round(value)}%` : `${Math.round(value)} ms`;
}
function initGauges() {
  ['cpu', 'net', 'disk'].forEach(id => buildTicks(document.getElementById(`gauge-${id}-ticks`)));
  let cpu = 32, net = 18, disk = 54;
  function tick() {
    cpu = clamp(cpu + (Math.random() - 0.5) * 14, 8, 92);
    net = clamp(net + (Math.random() - 0.5) * 10, 4, 70);
    disk = clamp(disk + (Math.random() - 0.5) * 4, 30, 88);
    setGauge('cpu', cpu, '%');
    setGauge('net', net, 'ms');
    setGauge('disk', disk, '%');
    if (cpu > 82 || net > 60) setOttoStatus('alert');
    else if (state.ottoStatus === 'alert') setOttoStatus('idle');
  }
  tick();
  setInterval(tick, 2600);
}
function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }

/* ================================================================
   6) TREINAMENTOS
   ================================================================ */
const COURSES = [
  { id: 1, cat: 'infra', title: 'Fundamentos de Redes do Oitavão', desc: 'Topologia, VPN e boas práticas de conectividade interna.', pct: 40 },
  { id: 2, cat: 'seguranca', title: 'Segurança da Informação Essencial', desc: 'Phishing, senhas fortes e postura segura no dia a dia.', pct: 80 },
  { id: 3, cat: 'dev', title: 'Boas Práticas de Versionamento', desc: 'Git, revisão de código e fluxo de deploy do time.', pct: 15 },
  { id: 4, cat: 'dados', title: 'Introdução a Dashboards de Dados', desc: 'Leitura de métricas e construção de painéis simples.', pct: 60 },
  { id: 5, cat: 'infra', title: 'Administração de Servidores', desc: 'Manutenção preventiva e monitoramento de infraestrutura.', pct: 0 },
  { id: 6, cat: 'seguranca', title: 'Resposta a Incidentes', desc: 'Como agir nos primeiros minutos de um incidente técnico.', pct: 25 },
  { id: 7, cat: 'dev', title: 'Automação com Scripts', desc: 'Tarefas repetitivas resolvidas com pequenos scripts.', pct: 100 },
  { id: 8, cat: 'dados', title: 'Qualidade e Governança de Dados', desc: 'Padrões para manter os dados do Oitavão confiáveis.', pct: 5 },
];

function courseCard(c) {
  const done = c.pct >= 100;
  return `<div class="course-card glass" data-id="${c.id}">
    <div class="knob" style="--pct:${c.pct}"><span>${c.pct}%</span></div>
    <div class="course-info">
      <span class="cat">${catLabel(c.cat)}</span>
      <b>${c.title}</b>
      <p>${c.desc}</p>
      <button class="course-btn ${done ? 'done' : ''}" data-id="${c.id}">${done ? '✓ Concluído' : 'Continuar'}</button>
    </div>
  </div>`;
}
function catLabel(cat) {
  return { infra: 'Infraestrutura', seguranca: 'Segurança', dev: 'Desenvolvimento', dados: 'Dados' }[cat] || cat;
}

let courseFilter = 'todos', courseSearch = '';
function renderCourses() {
  const grid = document.getElementById('course-grid');
  const list = COURSES.filter(c =>
    (courseFilter === 'todos' || c.cat === courseFilter) &&
    (c.title.toLowerCase().includes(courseSearch) || c.desc.toLowerCase().includes(courseSearch))
  );
  grid.innerHTML = list.length ? list.map(courseCard).join('') :
    `<div class="faq-empty" style="grid-column:1/-1;">Nenhuma trilha encontrada.</div>`;
  document.getElementById('stat-courses').textContent = COURSES.length;
}
function initCourses() {
  renderCourses();
  document.getElementById('course-grid').addEventListener('click', (e) => {
    const btn = e.target.closest('.course-btn');
    if (!btn || btn.classList.contains('done')) return;
    clickSound();
    const id = Number(btn.dataset.id);
    const c = COURSES.find(x => x.id === id);
    c.pct = Math.min(100, c.pct + 20);
    renderCourses();
  });
  document.getElementById('course-filters').addEventListener('click', (e) => {
    const tab = e.target.closest('.filter-tab');
    if (!tab) return;
    clickSound();
    document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    courseFilter = tab.dataset.cat;
    renderCourses();
  });
  document.getElementById('course-search').addEventListener('input', (e) => {
    courseSearch = e.target.value.toLowerCase();
    renderCourses();
  });
}

/* ================================================================
   7) BASE DE CONHECIMENTO (FAQ)
   ================================================================ */
const FAQ = [
  { q: 'Como redefino minha senha de acesso?', a: 'Acesse portal.oitavao/conta e clique em "Esqueci minha senha". O link de redefinição chega no seu e-mail corporativo em poucos minutos.' },
  { q: 'O que fazer quando o wifi cai?', a: 'Reinicie o roteador local por 10 segundos. Se o painel de diagnóstico mostrar rede instável, já é um incidente conhecido sendo tratado.' },
  { q: 'Como funciona o backup dos meus arquivos?', a: 'Os backups rodam automaticamente todo dia às 03h. Restaurações específicas podem ser solicitadas via chamado.' },
  { q: 'Preciso de VPN para trabalhar de casa?', a: 'Sim. Instale o cliente de VPN indicado no e-mail de boas-vindas e autentique com usuário de rede + segundo fator.' },
  { q: 'Como acompanho meu progresso nos treinamentos?', a: 'Cada trilha mostra um indicador circular de progresso. Clique em "Continuar" para avançar — o progresso fica salvo durante sua sessão.' },
  { q: 'Qual o prazo de resposta de um chamado?', a: 'Chamados de prioridade alta são triados em minutos; média em algumas horas; baixa em até 1 dia útil.' },
  { q: 'Posso usar o OTTO fora do horário comercial?', a: 'Sim, o assistente funciona 24/7. O atendimento humano segue de segunda a sexta, das 8h às 18h.' },
];
let faqSearch = '';
function renderFaq() {
  const list = document.getElementById('faq-list');
  const filtered = FAQ.filter(f => (f.q + f.a).toLowerCase().includes(faqSearch));
  if (!filtered.length) {
    list.innerHTML = `<div class="faq-empty">Nenhum resultado para "${escapeHtml(faqSearch)}".</div>`;
    return;
  }
  list.innerHTML = filtered.map((f, i) => `
    <div class="faq-item" data-i="${i}">
      <button class="faq-q" type="button">${f.q}<span class="arrow">+</span></button>
      <div class="faq-a"><p>${f.a}</p></div>
    </div>`).join('');
}
function initFaq() {
  renderFaq();
  document.getElementById('faq-list').addEventListener('click', (e) => {
    const q = e.target.closest('.faq-q');
    if (!q) return;
    clickSound();
    q.parentElement.classList.toggle('open');
  });
  document.getElementById('faq-search').addEventListener('input', (e) => {
    faqSearch = e.target.value.toLowerCase();
    renderFaq();
  });
}

/* ================================================================
   8) CHAMADOS (tickets)
   ================================================================ */
function renderTickets() {
  const list = document.getElementById('ticket-list');
  if (!state.tickets.length) {
    list.innerHTML = `<div class="ticket-empty">Nenhum chamado aberto. Use o formulário ao lado para criar um.</div>`;
  } else {
    list.innerHTML = state.tickets.map(t => `
      <div class="ticket-card glass ${t.resolved ? 'resolved' : ''}" data-id="${t.id}">
        <span class="ticket-led p-${t.priority}"></span>
        <div class="ticket-body">
          <b>#${t.id} · ${escapeHtml(t.title)}</b>
          <div class="ticket-meta">${t.priority} · ${t.desc ? escapeHtml(t.desc) : 'sem descrição adicional'}</div>
        </div>
        <div class="ticket-actions">
          <button class="icon-btn" data-act="resolve" data-id="${t.id}" title="Marcar como resolvido">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M4 12l5 5L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="icon-btn" data-act="remove" data-id="${t.id}" title="Remover">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>`).join('');
  }
  document.getElementById('stat-tickets').textContent = state.tickets.filter(t => !t.resolved).length;
}
function addTicket(title, desc, priority) {
  state.tickets.unshift({ id: state.ticketSeq++, title, desc, priority, resolved: false });
  renderTickets();
}
function initTickets() {
  renderTickets();
  document.getElementById('priority-row').addEventListener('click', (e) => {
    const opt = e.target.closest('.priority-opt');
    if (!opt) return;
    clickSound();
    document.querySelectorAll('.priority-opt').forEach(o => o.classList.remove('sel'));
    opt.classList.add('sel');
    state.priority = opt.dataset.p;
  });
  document.getElementById('ticket-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const titleEl = document.getElementById('ticket-title');
    const descEl = document.getElementById('ticket-desc');
    if (!titleEl.value.trim()) return;
    addTicket(titleEl.value.trim(), descEl.value.trim(), state.priority);
    showToast(`Chamado #${state.ticketSeq - 1} criado com prioridade ${state.priority}.`);
    titleEl.value = ''; descEl.value = '';
    clickSound();
  });
  document.getElementById('ticket-list').addEventListener('click', (e) => {
    const btn = e.target.closest('.icon-btn');
    if (!btn) return;
    clickSound();
    const id = Number(btn.dataset.id);
    if (btn.dataset.act === 'resolve') {
      const t = state.tickets.find(x => x.id === id);
      if (t) t.resolved = !t.resolved;
    } else {
      state.tickets = state.tickets.filter(x => x.id !== id);
    }
    renderTickets();
  });
}

/* ================================================================
   9) TOAST
   ================================================================ */
let toastTimer = null;
function showToast(msg) {
  let toast = document.getElementById('toast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'toast';
    toast.className = 'toast';
    toast.innerHTML = `<span class="dot"></span><span id="toast-msg"></span>`;
    document.body.appendChild(toast);
  }
  document.getElementById('toast-msg').textContent = msg;
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('show'), 3200);
}

/* ================================================================
   10) PAINEL DE CONTROLE (tema, som, movimento, brilho)
   ================================================================ */
function initControls() {
  const rockerTheme = document.getElementById('rocker-theme');
  const chip = document.getElementById('theme-toggle-chip');
  function applyTheme() {
    document.documentElement.setAttribute('data-theme', state.theme);
  }
  function toggleTheme() {
    state.theme = state.theme === 'dark' ? 'light' : 'dark';
    applyTheme();
    rockerTheme.classList.toggle('on', state.theme === 'light');
    clickSound();
  }
  rockerTheme.addEventListener('click', toggleTheme);
  chip.addEventListener('click', toggleTheme);

  const rockerSound = document.getElementById('rocker-sound');
  rockerSound.addEventListener('click', () => {
    state.sound = !state.sound;
    rockerSound.classList.toggle('on', state.sound);
    toggleSoundFx(state.sound);
  });

  const rockerMotion = document.getElementById('rocker-motion');
  rockerMotion.addEventListener('click', () => {
    state.motion = !state.motion;
    rockerMotion.classList.toggle('on', state.motion);
    document.documentElement.setAttribute('data-motion', state.motion ? 'on' : 'off');
    clickSound();
  });

  const slider = document.getElementById('brightness-slider');
  slider.addEventListener('input', () => {
    state.brightness = Number(slider.value);
    slider.style.setProperty('--val', slider.value);
  });
}

/* ================================================================
   11) RELÓGIOS (topo + widget analógico)
   ================================================================ */
function initClocks() {
  const days = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb'];
  const months = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
  function tick() {
    const now = new Date();
    const hh = String(now.getHours()).padStart(2, '0');
    const mm = String(now.getMinutes()).padStart(2, '0');
    const ss = String(now.getSeconds()).padStart(2, '0');
    const timeStr = `${hh}:${mm}:${ss}`;
    document.getElementById('mini-clock').textContent = timeStr;
    document.getElementById('digital-time').textContent = timeStr;
    document.getElementById('digital-date').textContent =
      `${days[now.getDay()]}, ${now.getDate()} ${months[now.getMonth()]}`;
    const tickerTime = document.getElementById('ticker-time');
    if (tickerTime) tickerTime.textContent = timeStr;

    const hDeg = (now.getHours() % 12) * 30 + now.getMinutes() * 0.5;
    const mDeg = now.getMinutes() * 6;
    const sDeg = now.getSeconds() * 6;
    document.getElementById('hand-h').style.transform = `rotate(${hDeg}deg)`;
    document.getElementById('hand-m').style.transform = `rotate(${mDeg}deg)`;
    document.getElementById('hand-s').style.transform = `rotate(${sDeg}deg)`;
  }
  tick();
  setInterval(tick, 1000);
}

/* ================================================================
   12) NAV / SCROLL SPY / BOTÕES DE SCROLL
   ================================================================ */
function initNav() {
  document.querySelectorAll('[data-scroll]').forEach(btn => {
    btn.addEventListener('click', () => {
      clickSound();
      document.querySelector(btn.dataset.scroll).scrollIntoView({ behavior: 'smooth' });
    });
  });
  const pills = [...document.querySelectorAll('.nav-pills .pill')];
  const sections = pills.map(p => document.querySelector(p.getAttribute('href')));
  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = '#' + entry.target.id;
        pills.forEach(p => p.classList.toggle('active', p.getAttribute('href') === id));
      }
    });
  }, { rootMargin: '-40% 0px -55% 0px' });
  sections.forEach(s => s && io.observe(s));
}

/* ================================================================
   BOOT
   ================================================================ */
window.addEventListener('DOMContentLoaded', () => {
  runBoot();
  initCore();
  initChat();
  initEstimator();
  initGauges();
  initCourses();
  initFaq();
  initTickets();
  initControls();
  initClocks();
  initNav();
});

</script>
</body>
</html>
